rules_version = '2';

// 익명 오답 집계 전용 보안 규칙.
// - answer_logs: 교육생(비로그인)은 생성(create)만 가능. 문서 형태를 엄격히
//   검증해 임의 필드/타입 주입을 막는다.
// - createdAt은 반드시 serverTimestamp()여야 한다(`== request.time`). 타입만
//   검사하면 클라이언트가 임의 시각을 넣어 달력·기간별 통계를 오염시킬 수 있다.
// - survey_responses / sessions / question_sets: 클라이언트는 읽기도 쓰기도 못 한다.
//   만족도 응답은 `/api/survey`가 서비스 계정으로 쓴다. 규칙만으로는 "이 회차가
//   설문을 받기로 한 회차인가"를 알 수 없기 때문이다 — 그건 다른 문서(sessions)를
//   읽어야 아는 사실이고, 규칙은 그걸 조건으로 걸 수 없다.
// - 읽기는 클라이언트에 전면 금지. 회차별 통계(/admin)는 서버 라우트가
//   서비스 계정(Admin SDK)으로 읽어 집계 결과만 내려준다.
// - 그 외 모든 경로: 전면 차단.
//
// 배포: firebase deploy --only firestore:rules
// (개인 식별 정보는 절대 기록하지 않는다 — questionId/정오답/회차코드/createdAt만)

service cloud.firestore {
  match /databases/{database}/documents {

    // 교육 회차 코드 — 소문자/숫자/하이픈 1~24자.
    // groupCodeService.ts 의 CODE_PATTERN 과 동일하게 유지할 것.
    function isValidGroupCode(g) {
      return g is string && g.size() > 0 && g.size() <= 24 && g.matches('^[a-z0-9-]+$');
    }

    // 익명 답안 로그(세션 요약) — items 내부 원소({q,c})의 깊은 검증은
    // Firestore 규칙 한계상 강제하지 않는다(익명 데이터 + 추후 App Check로 남용 완화).
    // 형태(필드/타입)와 items 크기 상한만 검증한다.
    // g(교육 회차 코드)는 선택 필드 — 없으면 전체 집계에만 반영된다.
    function isValidAnswerLog() {
      let d = request.resource.data;
      return d.keys().hasOnly(['items', 'createdAt', 'g'])
        && d.items is list && d.items.size() > 0 && d.items.size() <= 200
        && d.createdAt == request.time
        && (!('g' in d) || isValidGroupCode(d.g));
    }

    // 익명 답안 로그(세션 요약) — 생성만 허용, 읽기/수정/삭제 금지.
    match /answer_logs/{docId} {
      allow create: if isValidAnswerLog();
      allow read, update, delete: if false;
    }

    // 교육 만족도 응답 — **클라이언트 쓰기 전면 차단**.
    //
    // 예전에는 여기서 생성을 허용하고 형태만 검증했다. 그 결과 링크에 `&s=1`만
    // 붙이면 설문을 켜지 않은 회차에도, 발급된 적 없는 코드로도 응답이 들어갔다.
    // 규칙은 `sessions/{code}`를 읽어 "설문을 받는 회차인가"를 따질 수 없으므로,
    // 쓰기를 `/api/survey`(서비스 계정)로 옮기고 여기서는 막는다.
    match /survey_responses/{docId} {
      allow read, write: if false;
    }

    // 교육 회차 등록부 — 서버 라우트(서비스 계정) 전용.
    // 교육반 이름·설문 여부·응답 수가 들어 있어 교육생에게 보일 이유가 없다.
    //
    // 지정 출제 문제(picks)는 교육생에게 보여 줄 값이지만, 그것도 `/api/session`이
    // 필요한 항목만 골라 내려준다. 문서를 통째로 열면 교육반 이름·응답 수까지
    // 같이 나간다.
    match /sessions/{code} {
      allow read, write: if false;
    }

    // 출제 세트 보관함 — 서버 라우트(서비스 계정) 전용.
    // 교수자가 쓰는 보관함이라 교육생 기기가 읽을 일이 없고, 쓰기를 열면
    // 남의 세트를 지우거나 덮어쓸 수 있다. 모든 접근은 `/api/admin/question-sets`가
    // 관리자 세션을 확인한 뒤 서비스 계정으로 한다.
    match /question_sets/{setId} {
      allow read, write: if false;
    }

    // 그 외 모든 문서 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
