rules_version = '2';

// 익명 오답 집계 전용 보안 규칙.
// - answer_logs / survey_responses: 교육생(비로그인)은 생성(create)만 가능.
//   문서 형태를 엄격히 검증해 임의 필드/타입 주입을 막는다.
// - createdAt은 반드시 serverTimestamp()여야 한다(`== request.time`). 타입만
//   검사하면 클라이언트가 임의 시각을 넣어 달력·기간별 통계를 오염시킬 수 있다.
// - 읽기는 클라이언트에 전면 금지. 회차별 통계(/admin)는 서버 라우트가
//   서비스 계정(Admin SDK)으로 읽어 집계 결과만 내려준다.
// - 그 외 모든 경로: 전면 차단.
//
// 배포: firebase deploy --only firestore:rules
// (개인 식별 정보는 절대 기록하지 않는다 — questionId/정오답/회차코드/createdAt만)

service cloud.firestore {
  match /databases/{database}/documents {

    // 교육 회차 코드 — 소문자/숫자/하이픈 1~24자.
    // groupCodeService.ts 의 CODE_PATTERN 과 동일하게 유지할 것.
    function isValidGroupCode(g) {
      return g is string && g.size() > 0 && g.size() <= 24 && g.matches('^[a-z0-9-]+$');
    }

    // 익명 답안 로그(세션 요약) — items 내부 원소({q,c})의 깊은 검증은
    // Firestore 규칙 한계상 강제하지 않는다(익명 데이터 + 추후 App Check로 남용 완화).
    // 형태(필드/타입)와 items 크기 상한만 검증한다.
    // g(교육 회차 코드)는 선택 필드 — 없으면 전체 집계에만 반영된다.
    function isValidAnswerLog() {
      let d = request.resource.data;
      return d.keys().hasOnly(['items', 'createdAt', 'g'])
        && d.items is list && d.items.size() > 0 && d.items.size() <= 200
        && d.createdAt == request.time
        && (!('g' in d) || isValidGroupCode(d.g));
    }

    // 익명 답안 로그(세션 요약) — 생성만 허용, 읽기/수정/삭제 금지.
    match /answer_logs/{docId} {
      allow create: if isValidAnswerLog();
      allow read, update, delete: if false;
    }

    // 척도 점수 — 1~5 정수만.
    function isValidRating(v) {
      return v is int && v >= 1 && v <= 5;
    }

    // 교육 만족도 응답.
    // answer_logs와 달리 g(회차 코드)가 **필수**다 — 회차 없는 만족도는 뜻이 없다.
    // ratings는 세 문항을 모두 요구하고(평균이 문항별로 들쭉날쭉해지지 않게),
    // comment(주관식)만 선택이며 길이 상한은 surveyService의 COMMENT_MAX_LENGTH와 같다.
    function isValidSurvey() {
      let d = request.resource.data;
      let r = d.ratings;
      return d.keys().hasOnly(['g', 'ratings', 'comment', 'createdAt'])
        && isValidGroupCode(d.g)
        && d.createdAt == request.time
        && r is map
        && r.keys().hasOnly(['overall', 'useful', 'instructor'])
        && r.keys().hasAll(['overall', 'useful', 'instructor'])
        && isValidRating(r.overall)
        && isValidRating(r.useful)
        && isValidRating(r.instructor)
        && (!('comment' in d) || (d.comment is string && d.comment.size() <= 200));
    }

    // 만족도 응답 — 생성만 허용. 읽기는 관리자 서버 라우트(Admin SDK)만.
    match /survey_responses/{docId} {
      allow create: if isValidSurvey();
      allow read, update, delete: if false;
    }

    // 그 외 모든 문서 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
